{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "minimumVersion": "2.1.198",
  "fallbackModel": ["claude-sonnet-5", "claude-haiku-4-5-20251001"],
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "50000",
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_LEAD_MODE": "true"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Skill",
      "AskUserQuestion",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "LSP",
      "NotebookEdit",
      "SendMessage",
      "mcp__plugin_context7_context7__*"
    ],
    "ask": [
      "Agent",
      "Workflow"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf /)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * -O - | sh)",
      "Bash(wget * -O - | bash)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(.env)",
      "Edit(*.pem)",
      "Edit(*credentials*)",
      "Edit(*secret*)",
      "Write(.env)",
      "Write(*.pem)",
      "Write(.env.*)",
      "Write(*credentials*)",
      "Write(*secret*)",
      "Write(./secrets/**)",
      "Read(*.pem)",
      "Read(*credentials*)",
      "Read(*secret*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "bun $HOME/.claude/hooks/skill-activation.ts", "timeout": 10}]}],
    "InstructionsLoaded": [{"hooks": [{"type": "command", "command": "bun $HOME/.claude/hooks/instructions-loaded.ts", "timeout": 10, "async": true}]}],
    "Stop": [{"matcher": "", "hooks": [{"type": "command", "command": "bun $HOME/.claude/hooks/security-gate.ts", "timeout": 10}]}],
    "PostCompact": [{"hooks": [{"type": "command", "command": "bun $HOME/.claude/hooks/post-compact.ts", "timeout": 10}]}],
    "SessionStart": [{"hooks": [{"type": "command", "command": "bun $HOME/.claude/hooks/workspace-hint.ts", "timeout": 10}]}]
  },
  "worktree": {
    "symlinkDirectories": ["node_modules", ".venv"],
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "outputStyle": "Poneglyph",
  "language": "spanish",
  "theme": "dark",
  "tui": "fullscreen",
  "autoUpdatesChannel": "latest",
  "effortLevel": "xhigh",
  "sandbox": {"enabled": false},
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": ["Pensando", "Analizando", "Investigando", "Procesando", "Evaluando", "Planificando", "Construyendo", "Revisando", "Optimizando"]
  },
  "advisorModel": "opus",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "agentPushNotifEnabled": false,
  "remoteControlAtStartup": false,
  "preferredNotifChannel": "iterm2_with_bell",
  "editorMode": "normal",
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "hard_deny": [
      "Bash(rm -rf .claude)",
      "Bash(rm -rf .claude/*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "soft_deny": [
      "$defaults",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.global.json)",
      "Write(.claude/settings.global.json)",
      "Bash(rm .claude)"
    ]
  }
}
